# Leave blank to use the persisted Telegram setting (default: conservative).
# Set explicitly only to lock the container to one profile.
SCANNER_LOAD_PROFILE=

# Optional keyed/private endpoints. They are prepended to, not substituted for,
# the public fallbacks from config.yaml. Multiple URLs may be comma-separated.
ETHEREUM_RPC=
BSC_RPC=
POLYGON_RPC=
ARBITRUM_RPC=
OPTIMISM_RPC=
BASE_RPC=
ZK_RPC=
ZKSYNC_RPC=
ROBINHOOD_RPC=
HYPERLIQUID_RPC=

# Telegram monitor. Keep the real token only in .env (chmod 600 on Linux).
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat IDs. Empty means deny everyone.
TELEGRAM_CHAT_IDS=
TELEGRAM_TIMEZONE=Europe/Moscow
DOCKER_PROXY_URL=http://docker-proxy:2375
NODE_EXPORTER_URL=http://node-exporter:9100
SCANNER_CONTAINER_NAME=evm-scanner
# Fixed startup arguments, maintained on the server rather than through Telegram.
SCANNER_ARGS=--min-usd 500000
LINEA_RPC=
SCROLL_RPC=
MANTLE_RPC=
BLAST_RPC=
CELO_RPC=
GNOSIS_RPC=
CRONOS_RPC=
KAVA_RPC=
METIS_RPC=
HARMONY_RPC=

# Sui indexed API. Store the real key only in .env.
BLOCKBERRY_API_KEY=
# Optional Alchemy Sui JSON-RPC URLs, comma-separated diagnostic fallbacks.
SUI_RPC=

# Example:
# ETHEREUM_RPC=https://eth-mainnet.example/v2/YOUR_KEY,https://second.example/YOUR_KEY
